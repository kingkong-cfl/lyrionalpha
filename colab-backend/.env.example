# Set MOCK_GPU=false when running on Google Colab L4 GPU
MOCK_GPU=true

# Persistent storage root (automatically switches to /content/drive/MyDrive/AIMusicStudio in Colab)
DRIVE_ROOT=./data/AIMusicStudio

# Primary Zero-VRAM AI Producer (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Automatic Fallback LLM Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Secondary Fallback (NVIDIA NIM)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# CORS Origins (comma-separated or * for local/tunnel dev)
ALLOWED_ORIGINS=*
